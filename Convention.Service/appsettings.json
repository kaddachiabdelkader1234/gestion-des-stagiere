{
  "Spring": {
    "Application": {
      "Name": "CONVENTION-SERVICE"
    }
  },
  "Eureka": {
    "Client": {
      "Enabled": true,
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": true,
      "ServiceUrl": "http://localhost:8761/eureka/"
    },
    "Instance": {
      "PreferIPAddress": true
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=convention_service_db;Username=postgres;Password=postgres;Maximum Pool Size=20;Minimum Pool Size=5;Connection Idle Lifetime=300"
  },
  "Jwt": {
    "Secret": ""
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Steeltoe.Discovery": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss",
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AllowedHosts": "*"
}