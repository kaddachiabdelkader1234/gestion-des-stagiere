# Root environment example for Docker Compose and local development
# Copy to .env and fill with local-only development values:
#   cp .env.example .env
#
# .env is gitignored — never commit real secrets.

# ---- Shared JWT secret (REQUIRED) ----
# One value signs and validates tokens across auth-service (Java), the API Gateway,
# and all four .NET services. They MUST match or every authenticated request fails.
# None of those services define a fallback, so an unset JWT_SECRET is a startup failure.
#
# HS256 requires at least 32 bytes. Generate one with:
#   openssl rand -base64 48
# or, on Windows PowerShell:
#   $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace-with-openssl-rand-base64-48-output-min-32-bytes

# ---- Admin seed (created on first boot) ----
# If no ADMIN account exists when auth-service starts, one is created with these values.
# Safe to leave in .env — the seed is a no-op if an admin already exists.
ADMIN_EMAIL=admin@stb.tn
ADMIN_PASSWORD=Admin123!

# ---- Gateway ----
# The gateway binds 18080 (see Backend/api-gateway/src/main/resources/application.yml).
GATEWAY_URL=http://localhost:18080
GATEWAY_ALLOWED_ORIGINS=http://localhost:4200

# Config Server
CONFIG_SERVER_URL=http://config-server:8888

# Eureka Discovery
EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka/
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka-server:8761/eureka/

# ---- MySQL (auth-service) ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=smartek_db
# allowPublicKeyRetrieval=true is needed because MySQL 8 uses caching_sha2_password and this URL
# disables SSL — without it the driver fails with "Public Key Retrieval is not allowed".
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/smartek_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# ---- PostgreSQL (.NET services) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ---- Monitoring (for future use) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
